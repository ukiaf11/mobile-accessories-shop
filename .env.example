# ─────────────────────────────────────────────────────────────────────────────
# Server-side only. NEVER prefix any of these with VITE_ — anything VITE_-prefixed
# is inlined into the browser bundle. Blueprint 02 section 5 / 08 section 1.
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where order requests are delivered. The server always sends here and ignores any
# recipient in the request body (blueprint 08 section 4).
SHOP_OWNER_EMAIL=owner@example.com

# Verified sending identity on your Resend domain.
MAIL_FROM="Mobile Accessories Shop <orders@yourshop.in>"

# Shown in the email header. Falls back to "Mobile Accessories Shop".
SHOP_NAME="Mobile Accessories Shop"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: shared rate limiting across serverless instances.
# Without these the API falls back to a per-instance in-memory limiter, which is a
# speed bump rather than a real control. Create a free database at upstash.com.
# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
